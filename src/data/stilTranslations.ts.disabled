  sf5: {
    prompt: 'Welche Stilfigur liegt vor? "Die Kunst ist lang, und kurz ist unser Leben." / Hangi Stilfigur? "Die Kunst ist lang, und kurz ist unser Leben."',
    explanation: 'Chiasmus: überkreuzte Satzstellung (AB…BA). / Chiasmus: çapraz söz dizimi (AB…BA).',
